# 数据库连接（MySQL）。格式：
#   DATABASE_URL="mysql://用户名:密码@主机:3306/数据库名?connection_limit=5"
DATABASE_URL="mysql://root:@127.0.0.1:3306/gamerank"
PORT=3000
# 建议生产环境替换为随机 32 位以上字符串
JWT_SECRET="change-me-to-a-long-random-secret"
# SteamGridDB 免费 API Key
SGDB_API_KEY=""
# 每次 SteamGridDB 请求之间等待的毫秒数（免费版限速，约 1 请求/秒）
SGDB_RATE_DELAY=1200

# ---- Cloudflare R2 图片双写（CDN 主源 + 本地兜底）----
# 留空则不启用 R2，全部走本地 /uploads/（前端 onerror 会自然回退本地）。
# R2_ENDPOINT 形如 https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# 图片 CDN 公开域名（绑在 R2 桶上的自定义域名，与前端 VITE_IMG_CDN_BASE 保持一致）
IMG_CDN_BASE="https://image-gamerank.garfieldgod.cn"
